{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile owning synced trading journal records.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name or email prefix.",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Authenticated email address of the user.",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Per-user application preferences and active workspace filters synced under users/{userId}/settings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings document identifier (e.g., preferences).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "language": {
          "type": "string",
          "enum": ["it", "en", "es"],
          "maxLength": 8
        },
        "activeTab": {
          "type": "string",
          "enum": ["dashboard", "backtest", "live", "missed"],
          "maxLength": 16
        },
        "selectedSetup": {
          "type": "string",
          "maxLength": 40
        },
        "assetFilter": {
          "type": "string",
          "maxLength": 32
        },
        "activePortfolioAssets": {
          "type": "array",
          "description": "Selected Backtest assets active in Dashboard comparisons."
        },
        "customAssets": {
          "type": "array",
          "description": "User-registered custom trading asset symbols persisted across sessions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "language",
        "activeTab",
        "selectedSetup",
        "assetFilter",
        "createdAt",
        "updatedAt"
      ]
    },
    "Trade": {
      "title": "Trade",
      "description": "Mechanical trading journal entry belonging strictly to one authenticated user across Backtest and Live Journal.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["backtest", "live"],
          "description": "Journal bucket separating backtest and executed live journal."
        },
        "date": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "day": {
          "type": "string",
          "maxLength": 32
        },
        "session": {
          "type": "string",
          "maxLength": 40
        },
        "entryTime": {
          "type": "string",
          "maxLength": 20
        },
        "exitTime": {
          "type": "string",
          "maxLength": 20
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "setup": {
          "type": "string",
          "enum": ["S1", "SSA", "MUT", "SBIL DOMINANCE REALE", "SBIL INTRADOMINANCE"],
          "maxLength": 40
        },
        "strategy": {
          "type": "string",
          "enum": ["S1", "SSA", "MUT", "SBIL DOMINANCE REALE", "SBIL INTRADOMINANCE"],
          "maxLength": 40
        },
        "isMissed": {
          "type": "boolean"
        },
        "bias": {
          "type": "string",
          "enum": ["LONG", "SHORT"]
        },
        "riskPct": {
          "type": "number"
        },
        "entryPrice": {
          "type": "number"
        },
        "slPrice": {
          "type": "number"
        },
        "tpPrice": {
          "type": "number"
        },
        "slPips": {
          "type": "number"
        },
        "tpPips": {
          "type": "number"
        },
        "targetRR": {
          "type": "number"
        },
        "outcome": {
          "type": "string",
          "enum": ["TP", "STOP LOSS", "BE", "UNFILLED"]
        },
        "netR": {
          "type": "number"
        },
        "rrMax": {
          "type": "number"
        },
        "netReturnPct": {
          "type": "number"
        },
        "missedReason": {
          "type": "string",
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "tradingViewUrl": {
          "type": "string",
          "maxLength": 500
        },
        "extraColumns": {
          "type": "object"
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "category",
        "date",
        "asset",
        "setup",
        "strategy",
        "isMissed",
        "bias",
        "riskPct",
        "outcome",
        "netR",
        "netReturnPct",
        "notes",
        "tradingViewUrl",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "MissedTrade": {
      "title": "MissedTrade",
      "description": "Standalone missed-trade entry belonging strictly to one authenticated user in Trade Non Presi.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["missed"],
          "description": "Strictly isolated missed-trade category."
        },
        "date": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "day": {
          "type": "string",
          "maxLength": 32
        },
        "session": {
          "type": "string",
          "maxLength": 40
        },
        "entryTime": {
          "type": "string",
          "maxLength": 20
        },
        "exitTime": {
          "type": "string",
          "maxLength": 20
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "setup": {
          "type": "string",
          "enum": ["S1", "SSA", "MUT", "SBIL DOMINANCE REALE", "SBIL INTRADOMINANCE"],
          "maxLength": 40
        },
        "strategy": {
          "type": "string",
          "enum": ["S1", "SSA", "MUT", "SBIL DOMINANCE REALE", "SBIL INTRADOMINANCE"],
          "maxLength": 40
        },
        "isMissed": {
          "type": "boolean"
        },
        "bias": {
          "type": "string",
          "enum": ["LONG", "SHORT"]
        },
        "riskPct": {
          "type": "number"
        },
        "entryPrice": {
          "type": "number"
        },
        "slPrice": {
          "type": "number"
        },
        "tpPrice": {
          "type": "number"
        },
        "slPips": {
          "type": "number"
        },
        "tpPips": {
          "type": "number"
        },
        "targetRR": {
          "type": "number"
        },
        "outcome": {
          "type": "string",
          "enum": ["TP", "STOP LOSS", "BE", "UNFILLED"]
        },
        "netR": {
          "type": "number"
        },
        "rrMax": {
          "type": "number"
        },
        "netReturnPct": {
          "type": "number"
        },
        "missedReason": {
          "type": "string",
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "tradingViewUrl": {
          "type": "string",
          "maxLength": 500
        },
        "extraColumns": {
          "type": "object"
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "category",
        "date",
        "asset",
        "setup",
        "strategy",
        "isMissed",
        "bias",
        "riskPct",
        "outcome",
        "netR",
        "netReturnPct",
        "notes",
        "tradingViewUrl",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "GoogleSheetSource": {
      "title": "GoogleSheetSource",
      "description": "Saved multi-tab Google Sheet link paired with a trading asset for direct sync.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "asset": {
          "type": "string",
          "description": "Trading asset symbol paired with the Google Sheet (e.g., CHF/JPY).",
          "minLength": 1,
          "maxLength": 32
        },
        "sheetUrl": {
          "type": "string",
          "description": "Google Sheets URL.",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^https://docs\\.google\\.com/spreadsheets/.*"
        },
        "spreadsheetId": {
          "type": "string",
          "description": "Extracted Google Spreadsheet ID.",
          "minLength": 10,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["backtest", "live", "missed"],
          "description": "Target journal bucket for synced rows.",
          "maxLength": 16
        },
        "lastSyncedAt": {
          "type": "number",
          "description": "Epoch timestamp in ms of the latest sync."
        },
        "lastSyncSummary": {
          "type": "string",
          "description": "Short summary of the latest sync.",
          "maxLength": 160
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "asset",
        "sheetUrl",
        "spreadsheetId",
        "category",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile document acting as the root parent for the user's trading journal subcollections."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Per-user application preferences (language, active tab, default filters)."
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "Per-user trading journal entries across Backtest and Live Journal only."
    },
    "/users/{userId}/missedTrades/{tradeId}": {
      "schema": { "$ref": "#/entities/MissedTrade" },
      "description": "Per-user isolated Trade Non Presi entries stored separately from Backtest and Live Journal."
    },
    "/users/{userId}/googleSheets/{sheetId}": {
      "schema": { "$ref": "#/entities/GoogleSheetSource" },
      "description": "Per-user saved Google Sheets paired with Asset names for direct multi-tab sync."
    }
  }
}
